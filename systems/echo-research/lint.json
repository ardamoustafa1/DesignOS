{
  "schemaVersion": "designos-system-lint/v1",
  "id": "echo-research",
  "tokenPrefix": "--echo-research-",
  "requiredTokens": [
    "--echo-research-display",
    "--echo-research-text",
    "--echo-research-mono",
    "--echo-research-ground",
    "--echo-research-surface",
    "--echo-research-raised",
    "--echo-research-ink",
    "--echo-research-ink-2",
    "--echo-research-accent",
    "--echo-research-on-accent",
    "--echo-research-ring",
    "--echo-research-edge-lit",
    "--echo-research-shadow-rgb",
    "--echo-research-elev-1",
    "--echo-research-elev-2",
    "--echo-research-elev-3",
    "--echo-research-grain",
    "--echo-research-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "DM Serif Display",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--echo-research-elev-1",
      "--echo-research-elev-2",
      "--echo-research-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--echo-research-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--echo-research-grain",
      "feTurbulence"
    ]
  }
}
