{
  "schemaVersion": "designos-system-lint/v1",
  "id": "zephyr-social",
  "tokenPrefix": "--zephyr-social-",
  "requiredTokens": [
    "--zephyr-social-display",
    "--zephyr-social-text",
    "--zephyr-social-mono",
    "--zephyr-social-ground",
    "--zephyr-social-surface",
    "--zephyr-social-raised",
    "--zephyr-social-ink",
    "--zephyr-social-ink-2",
    "--zephyr-social-accent",
    "--zephyr-social-on-accent",
    "--zephyr-social-ring",
    "--zephyr-social-edge-lit",
    "--zephyr-social-shadow-rgb",
    "--zephyr-social-elev-1",
    "--zephyr-social-elev-2",
    "--zephyr-social-elev-3",
    "--zephyr-social-grain",
    "--zephyr-social-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Bodoni Moda",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--zephyr-social-elev-1",
      "--zephyr-social-elev-2",
      "--zephyr-social-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--zephyr-social-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--zephyr-social-grain",
      "feTurbulence"
    ]
  }
}
