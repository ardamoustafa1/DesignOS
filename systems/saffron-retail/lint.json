{
  "schemaVersion": "designos-system-lint/v1",
  "id": "saffron-retail",
  "tokenPrefix": "--saffron-retail-",
  "requiredTokens": [
    "--saffron-retail-display",
    "--saffron-retail-text",
    "--saffron-retail-mono",
    "--saffron-retail-ground",
    "--saffron-retail-surface",
    "--saffron-retail-raised",
    "--saffron-retail-ink",
    "--saffron-retail-ink-2",
    "--saffron-retail-accent",
    "--saffron-retail-on-accent",
    "--saffron-retail-ring",
    "--saffron-retail-edge-lit",
    "--saffron-retail-shadow-rgb",
    "--saffron-retail-elev-1",
    "--saffron-retail-elev-2",
    "--saffron-retail-elev-3",
    "--saffron-retail-grain",
    "--saffron-retail-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Fraunces",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--saffron-retail-elev-1",
      "--saffron-retail-elev-2",
      "--saffron-retail-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--saffron-retail-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--saffron-retail-grain",
      "feTurbulence"
    ]
  }
}
