{
  "schemaVersion": "designos-system-lint/v1",
  "id": "inkstone-publishing",
  "tokenPrefix": "--inkstone-publishing-",
  "requiredTokens": [
    "--inkstone-publishing-display",
    "--inkstone-publishing-text",
    "--inkstone-publishing-mono",
    "--inkstone-publishing-ground",
    "--inkstone-publishing-surface",
    "--inkstone-publishing-raised",
    "--inkstone-publishing-ink",
    "--inkstone-publishing-ink-2",
    "--inkstone-publishing-accent",
    "--inkstone-publishing-on-accent",
    "--inkstone-publishing-ring",
    "--inkstone-publishing-edge-lit",
    "--inkstone-publishing-shadow-rgb",
    "--inkstone-publishing-elev-1",
    "--inkstone-publishing-elev-2",
    "--inkstone-publishing-elev-3",
    "--inkstone-publishing-grain",
    "--inkstone-publishing-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Instrument Serif",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--inkstone-publishing-elev-1",
      "--inkstone-publishing-elev-2",
      "--inkstone-publishing-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--inkstone-publishing-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--inkstone-publishing-grain",
      "feTurbulence"
    ]
  }
}
