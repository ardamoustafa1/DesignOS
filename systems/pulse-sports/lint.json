{
  "schemaVersion": "designos-system-lint/v1",
  "id": "pulse-sports",
  "tokenPrefix": "--pulse-sports-",
  "requiredTokens": [
    "--pulse-sports-display",
    "--pulse-sports-text",
    "--pulse-sports-mono",
    "--pulse-sports-ground",
    "--pulse-sports-surface",
    "--pulse-sports-raised",
    "--pulse-sports-ink",
    "--pulse-sports-ink-2",
    "--pulse-sports-accent",
    "--pulse-sports-on-accent",
    "--pulse-sports-ring",
    "--pulse-sports-edge-lit",
    "--pulse-sports-shadow-rgb",
    "--pulse-sports-elev-1",
    "--pulse-sports-elev-2",
    "--pulse-sports-elev-3",
    "--pulse-sports-grain",
    "--pulse-sports-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Playfair Display",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--pulse-sports-elev-1",
      "--pulse-sports-elev-2",
      "--pulse-sports-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--pulse-sports-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--pulse-sports-grain",
      "feTurbulence"
    ]
  }
}
