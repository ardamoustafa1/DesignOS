{
  "schemaVersion": "designos-system-lint/v1",
  "id": "grove-learning",
  "tokenPrefix": "--grove-learning-",
  "requiredTokens": [
    "--grove-learning-display",
    "--grove-learning-text",
    "--grove-learning-mono",
    "--grove-learning-ground",
    "--grove-learning-surface",
    "--grove-learning-raised",
    "--grove-learning-ink",
    "--grove-learning-ink-2",
    "--grove-learning-accent",
    "--grove-learning-on-accent",
    "--grove-learning-ring",
    "--grove-learning-edge-lit",
    "--grove-learning-shadow-rgb",
    "--grove-learning-elev-1",
    "--grove-learning-elev-2",
    "--grove-learning-elev-3",
    "--grove-learning-grain",
    "--grove-learning-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Cormorant Garamond",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--grove-learning-elev-1",
      "--grove-learning-elev-2",
      "--grove-learning-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--grove-learning-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--grove-learning-grain",
      "feTurbulence"
    ]
  }
}
