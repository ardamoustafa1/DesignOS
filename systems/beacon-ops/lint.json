{
  "schemaVersion": "designos-system-lint/v1",
  "id": "beacon-ops",
  "tokenPrefix": "--beacon-ops-",
  "requiredTokens": [
    "--beacon-ops-display",
    "--beacon-ops-text",
    "--beacon-ops-mono",
    "--beacon-ops-ground",
    "--beacon-ops-surface",
    "--beacon-ops-raised",
    "--beacon-ops-ink",
    "--beacon-ops-ink-2",
    "--beacon-ops-accent",
    "--beacon-ops-on-accent",
    "--beacon-ops-ring",
    "--beacon-ops-edge-lit",
    "--beacon-ops-shadow-rgb",
    "--beacon-ops-elev-1",
    "--beacon-ops-elev-2",
    "--beacon-ops-elev-3",
    "--beacon-ops-grain",
    "--beacon-ops-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Source Serif 4",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--beacon-ops-elev-1",
      "--beacon-ops-elev-2",
      "--beacon-ops-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--beacon-ops-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--beacon-ops-grain",
      "feTurbulence"
    ]
  }
}
