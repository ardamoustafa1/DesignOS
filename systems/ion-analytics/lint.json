{
  "schemaVersion": "designos-system-lint/v1",
  "id": "ion-analytics",
  "tokenPrefix": "--ion-analytics-",
  "requiredTokens": [
    "--ion-analytics-display",
    "--ion-analytics-text",
    "--ion-analytics-mono",
    "--ion-analytics-ground",
    "--ion-analytics-surface",
    "--ion-analytics-raised",
    "--ion-analytics-ink",
    "--ion-analytics-ink-2",
    "--ion-analytics-accent",
    "--ion-analytics-on-accent",
    "--ion-analytics-ring",
    "--ion-analytics-edge-lit",
    "--ion-analytics-shadow-rgb",
    "--ion-analytics-elev-1",
    "--ion-analytics-elev-2",
    "--ion-analytics-elev-3",
    "--ion-analytics-grain",
    "--ion-analytics-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Newsreader",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--ion-analytics-elev-1",
      "--ion-analytics-elev-2",
      "--ion-analytics-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--ion-analytics-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--ion-analytics-grain",
      "feTurbulence"
    ]
  }
}
