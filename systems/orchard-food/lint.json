{
  "schemaVersion": "designos-system-lint/v1",
  "id": "orchard-food",
  "tokenPrefix": "--orchard-food-",
  "requiredTokens": [
    "--orchard-food-display",
    "--orchard-food-text",
    "--orchard-food-mono",
    "--orchard-food-ground",
    "--orchard-food-surface",
    "--orchard-food-raised",
    "--orchard-food-ink",
    "--orchard-food-ink-2",
    "--orchard-food-accent",
    "--orchard-food-on-accent",
    "--orchard-food-ring",
    "--orchard-food-edge-lit",
    "--orchard-food-shadow-rgb",
    "--orchard-food-elev-1",
    "--orchard-food-elev-2",
    "--orchard-food-elev-3",
    "--orchard-food-grain",
    "--orchard-food-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Cormorant Garamond",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--orchard-food-elev-1",
      "--orchard-food-elev-2",
      "--orchard-food-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--orchard-food-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--orchard-food-grain",
      "feTurbulence"
    ]
  }
}
