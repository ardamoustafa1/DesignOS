  "requiredTokens": [
    "--boreal-health-display",
    "--boreal-health-text",
    "--boreal-health-mono",
    "--boreal-health-ground",
    "--boreal-health-surface",
    "--boreal-health-raised",
    "--boreal-health-ink",
    "--boreal-health-ink-2",
    "--boreal-health-accent",
    "--boreal-health-on-accent",
    "--boreal-health-ring",
    "--boreal-health-edge-lit",
    "--boreal-health-shadow-rgb",
    "--boreal-health-elev-1",
    "--boreal-health-elev-2",
