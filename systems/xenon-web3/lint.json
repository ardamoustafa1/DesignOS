{
  "schemaVersion": "designos-system-lint/v1",
  "id": "xenon-web3",
  "tokenPrefix": "--xenon-web3-",
  "requiredTokens": [
    "--xenon-web3-display",
    "--xenon-web3-text",
    "--xenon-web3-mono",
    "--xenon-web3-ground",
    "--xenon-web3-surface",
    "--xenon-web3-raised",
    "--xenon-web3-ink",
    "--xenon-web3-ink-2",
    "--xenon-web3-accent",
    "--xenon-web3-on-accent",
    "--xenon-web3-ring",
    "--xenon-web3-edge-lit",
    "--xenon-web3-shadow-rgb",
    "--xenon-web3-elev-1",
    "--xenon-web3-elev-2",
    "--xenon-web3-elev-3",
    "--xenon-web3-grain",
    "--xenon-web3-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Playfair Display",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--xenon-web3-elev-1",
      "--xenon-web3-elev-2",
      "--xenon-web3-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--xenon-web3-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--xenon-web3-grain",
      "feTurbulence"
    ]
  }
}
