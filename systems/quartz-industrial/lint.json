{
  "schemaVersion": "designos-system-lint/v1",
  "id": "quartz-industrial",
  "tokenPrefix": "--quartz-industrial-",
  "requiredTokens": [
    "--quartz-industrial-display",
    "--quartz-industrial-text",
    "--quartz-industrial-mono",
    "--quartz-industrial-ground",
    "--quartz-industrial-surface",
    "--quartz-industrial-raised",
    "--quartz-industrial-ink",
    "--quartz-industrial-ink-2",
    "--quartz-industrial-accent",
    "--quartz-industrial-on-accent",
    "--quartz-industrial-ring",
    "--quartz-industrial-edge-lit",
    "--quartz-industrial-shadow-rgb",
    "--quartz-industrial-elev-1",
    "--quartz-industrial-elev-2",
    "--quartz-industrial-elev-3",
    "--quartz-industrial-grain",
    "--quartz-industrial-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Newsreader",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--quartz-industrial-elev-1",
      "--quartz-industrial-elev-2",
      "--quartz-industrial-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--quartz-industrial-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--quartz-industrial-grain",
      "feTurbulence"
    ]
  }
}
