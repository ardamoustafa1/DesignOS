{
  "schemaVersion": "designos-system-lint/v1",
  "id": "circuit-developer",
  "tokenPrefix": "--circuit-developer-",
  "requiredTokens": [
    "--circuit-developer-display",
    "--circuit-developer-text",
    "--circuit-developer-mono",
    "--circuit-developer-ground",
    "--circuit-developer-surface",
    "--circuit-developer-raised",
    "--circuit-developer-ink",
    "--circuit-developer-ink-2",
    "--circuit-developer-accent",
    "--circuit-developer-on-accent",
    "--circuit-developer-ring",
    "--circuit-developer-edge-lit",
    "--circuit-developer-shadow-rgb",
    "--circuit-developer-elev-1",
    "--circuit-developer-elev-2",
    "--circuit-developer-elev-3",
    "--circuit-developer-grain",
    "--circuit-developer-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "DM Serif Display",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--circuit-developer-elev-1",
      "--circuit-developer-elev-2",
      "--circuit-developer-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--circuit-developer-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--circuit-developer-grain",
      "feTurbulence"
    ]
  }
}
