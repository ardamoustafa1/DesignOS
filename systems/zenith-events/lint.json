{
  "schemaVersion": "designos-system-lint/v1",
  "id": "zenith-events",
  "tokenPrefix": "--zenith-events-",
  "requiredTokens": [
    "--zenith-events-display",
    "--zenith-events-text",
    "--zenith-events-mono",
    "--zenith-events-ground",
    "--zenith-events-surface",
    "--zenith-events-raised",
    "--zenith-events-ink",
    "--zenith-events-ink-2",
    "--zenith-events-accent",
    "--zenith-events-on-accent",
    "--zenith-events-ring",
    "--zenith-events-edge-lit",
    "--zenith-events-shadow-rgb",
    "--zenith-events-elev-1",
    "--zenith-events-elev-2",
    "--zenith-events-elev-3",
    "--zenith-events-grain",
    "--zenith-events-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Fraunces",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--zenith-events-elev-1",
      "--zenith-events-elev-2",
      "--zenith-events-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--zenith-events-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--zenith-events-grain",
      "feTurbulence"
    ]
  }
}
