{
  "schemaVersion": "designos-system-lint/v1",
  "id": "relay-mobility",
  "tokenPrefix": "--relay-mobility-",
  "requiredTokens": [
    "--relay-mobility-display",
    "--relay-mobility-text",
    "--relay-mobility-mono",
    "--relay-mobility-ground",
    "--relay-mobility-surface",
    "--relay-mobility-raised",
    "--relay-mobility-ink",
    "--relay-mobility-ink-2",
    "--relay-mobility-accent",
    "--relay-mobility-on-accent",
    "--relay-mobility-ring",
    "--relay-mobility-edge-lit",
    "--relay-mobility-shadow-rgb",
    "--relay-mobility-elev-1",
    "--relay-mobility-elev-2",
    "--relay-mobility-elev-3",
    "--relay-mobility-grain",
    "--relay-mobility-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Newsreader",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--relay-mobility-elev-1",
      "--relay-mobility-elev-2",
      "--relay-mobility-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--relay-mobility-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--relay-mobility-grain",
      "feTurbulence"
    ]
  }
}
