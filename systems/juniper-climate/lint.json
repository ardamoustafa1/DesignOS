{
  "schemaVersion": "designos-system-lint/v1",
  "id": "juniper-climate",
  "tokenPrefix": "--juniper-climate-",
  "requiredTokens": [
    "--juniper-climate-display",
    "--juniper-climate-text",
    "--juniper-climate-mono",
    "--juniper-climate-ground",
    "--juniper-climate-surface",
    "--juniper-climate-raised",
    "--juniper-climate-ink",
    "--juniper-climate-ink-2",
    "--juniper-climate-accent",
    "--juniper-climate-on-accent",
    "--juniper-climate-ring",
    "--juniper-climate-edge-lit",
    "--juniper-climate-shadow-rgb",
    "--juniper-climate-elev-1",
    "--juniper-climate-elev-2",
    "--juniper-climate-elev-3",
    "--juniper-climate-grain",
    "--juniper-climate-ease"
  ],
  "forbiddenColors": {
    "values": [
      "#000",
      "#000000",
      "#fff",
      "#ffffff"
    ],
    "reason": "The chromatic ground and ink cast are binding."
  },
  "typefaces": {
    "display": "Fraunces",
    "text": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "radiusScale": [
    "6px",
    "12px",
    "20px"
  ],
  "spacingBase": 4,
  "containerWidths": [
    "680px",
    "1120px",
    "1360px"
  ],
  "minDistinctContainers": 2,
  "easings": [
    "cubic-bezier(.16,1,.3,1)",
    "linear"
  ],
  "elevation": {
    "tokens": [
      "--juniper-climate-elev-1",
      "--juniper-climate-elev-2",
      "--juniper-climate-elev-3"
    ],
    "allowAdHoc": false
  },
  "accent": {
    "token": "--juniper-climate-accent",
    "maxSolidFills": 3
  },
  "texture": {
    "required": true,
    "signals": [
      "--juniper-climate-grain",
      "feTurbulence"
    ]
  }
}
