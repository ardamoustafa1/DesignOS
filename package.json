{
  "name": "designos",
  "version": "2.7.0",
  "description": "The Design Intelligence Operating System for AI coding agents — Claude, Cursor, Copilot, Windsurf, Cline, Aider.",
  "author": "Arda Moustafa (https://github.com/ardamoustafa1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardamoustafa1/DesignOS.git"
  },
  "homepage": "https://ardamoustafa1.github.io/DesignOS/website/",
  "bugs": {
    "url": "https://github.com/ardamoustafa1/DesignOS/issues"
  },
  "bin": {
    "designos": "bin/designos.js"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "axe-core": "^4.10.3"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.25.8",
    "gsap": "^3.13.0",
    "lighthouse": "^13.4.1",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "svelte": "^5.37.3",
    "vue": "^3.5.18"
  },
  "files": [
    "bin",
    "agents",
    "brain",
    "checklists",
    "components",
    "capabilities",
    "evals/external/registry.json",
    "evals/isolated/registry-eval.json",
    "evals/category-leadership/pattern-routing.json",
    "examples",
    "foundations",
    "goldens/*.md",
    "i18n",
    "industries",
    "integrations",
    "loops",
    "memory",
    "references",
    "hooks",
    "motion",
    "museum",
    "native",
    "patterns",
    "prompts",
    "psychology",
    "scoring",
    "skills",
    "systems",
    "!systems/*/example.html",
    "starter",
    "recipes",
    "runtime",
    "adapters",
    "playbooks",
    "actions",
    "case-studies",
    "scripts/build-evidence-package.js",
    "scripts/postinstall-playwright.js",
    "validators",
    "workflows",
    "CLAUDE.md",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "GETTING-STARTED.md",
    "ARCHITECTURE.md",
    "CHEATSHEET.md",
    "GLOSSARY.md",
    "LIMITATIONS.md",
    "PROOF_STANDARD.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "design-system",
    "ui-design",
    "prompt-engineering",
    "cursor",
    "copilot",
    "windsurf",
    "cline",
    "aider",
    "design-rules",
    "accessibility",
    "design-intelligence",
    "llm",
    "openai"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall-playwright.js",
    "validate": "node validators/check-capability-ledger.js && node scripts/compile-public-claims.js && node validators/test-category-leadership.js && node validators/run-registry.js --with-refs examples/ website/ goldens/",
    "validate:strict": "npm run validate && node validators/check-aesthetic-slop.js examples/ --strict && node validators/check-aesthetic-slop.js website/ --strict && node validators/check-aesthetic-slop.js goldens/ --strict",
    "validate:contrast": "node validators/check-token-contrast.js examples/ && node validators/check-token-contrast.js website/ && node validators/check-token-contrast.js goldens/",
    "validate:motion": "node validators/check-motion.js examples/ && node validators/check-motion.js website/ && node validators/check-motion.js goldens/",
    "validate:slop": "node validators/check-aesthetic-slop.js examples/ && node validators/check-aesthetic-slop.js website/ && node validators/check-aesthetic-slop.js goldens/",
    "validate:ceiling": "node validators/check-craft-ceiling.js systems/ && node validators/check-craft-ceiling.js examples/editorial-portfolio.html",
    "validate:registry": "node validators/check-registry.js examples/ && node validators/check-registry.js website/ && node validators/check-registry.js goldens/",
    "detect": "node bin/designos.js detect",
    "motion-gaps": "node bin/designos.js motion-gaps",
    "signature-check": "node bin/designos.js signature-check",
    "originality-check": "node bin/designos.js originality-check",
    "vendor:detect": "node packages/designos-detect/scripts/sync-vendor.js",
    "check:vendor": "node packages/designos-detect/scripts/check-vendor-sync.js",
    "check:ledger": "node validators/check-capability-ledger.js",
    "check:package": "node validators/check-package-boundary.js",
    "ledger:update": "node validators/check-capability-ledger.js --write",
    "claims:update": "node scripts/compile-public-claims.js --write",
    "check:claims": "node scripts/compile-public-claims.js",
    "audit:systems": "node validators/check-system-integrity.js",
    "test": "node scripts/run-tests.js --suite unit",
    "test:browser": "node scripts/run-tests.js --suite browser",
    "test:all": "node scripts/run-tests.js --suite all",
    "test:frameworks": "node fixtures/frameworks/test-matrix.js",
    "test:motion-evidence": "node validators/test-motion-evidence.js",
    "test:leader": "node validators/test-leader-features.js && node validators/test-category-leadership.js",
    "test:live-component": "node validators/test-live-component.js",
    "test:live-studio": "node validators/test-live-studio.js",
    "test:isolated": "node bin/isolated-rule-eval.js",
    "test:independent": "npm run test:isolated",
    "verify:external-eval": "node bin/external-eval.js",
    "test:goldens": "node bin/golden-suite.js",
    "test:lighthouse": "node bin/lighthouse-gate.js website/index.html --out .designos/lighthouse.json",
    "update:goldens": "node bin/golden-suite.js --update",
    "pack:evidence": "node scripts/build-evidence-package.js",
    "check:links": "node validators/check-links.js --fast",
    "check:mobile-audit": "node scripts/mobile-audit-gate.js",
    "review": "node bin/designos.js review",
    "visual": "node bin/designos.js visual",
    "report": "node bin/designos.js report",
    "elevate": "node bin/designos.js elevate",
    "starter": "node bin/designos.js starter",
    "brief": "node bin/designos.js brief",
    "eval": "node bin/designos.js eval",
    "case": "node bin/designos.js case",
    "demo:terminal": "node scripts/demo-session.js",
    "demo:transcript": "bash scripts/record-demo.sh",
    "demo:gif": "python3 scripts/render-demo-gif.py",
    "doctor": "node bin/designos.js doctor",
    "audit": "node bin/designos.js audit",
    "validate:system": "node validators/check-system-conformance.js systems/kiln/example.html --system kiln",
    "audit:ceiling": "node validators/check-craft-ceiling.js examples/ ; node validators/check-craft-ceiling.js website/ ; node validators/check-craft-ceiling.js goldens/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
