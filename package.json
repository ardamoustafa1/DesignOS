  "scripts": {
    "validate": "node validators/run-registry.js --with-refs examples/ website/ goldens/",
    "validate:strict": "npm run validate && node validators/check-aesthetic-slop.js examples/ --strict && node validators/check-aesthetic-slop.js website/ --strict && node validators/check-aesthetic-slop.js goldens/ --strict",
    "validate:contrast": "node validators/check-token-contrast.js examples/ && node validators/check-token-contrast.js website/ && node validators/check-token-contrast.js goldens/",
    "validate:motion": "node validators/check-motion.js examples/ && node validators/check-motion.js website/ && node validators/check-motion.js goldens/",
    "validate:slop": "node validators/check-aesthetic-slop.js examples/ && node validators/check-aesthetic-slop.js website/ && node validators/check-aesthetic-slop.js goldens/",
    "validate:registry": "node validators/check-registry.js examples/ && node validators/check-registry.js website/ && node validators/check-registry.js goldens/",
    "test": "node validators/test-cli.js && node validators/check-modules.js && node runtime/motion/test-runtime.js && node validators/test-product-engines.js",
    "test:frameworks": "node fixtures/frameworks/test-matrix.js",
    "test:independent": "node bin/independent-eval.js",
    "test:goldens": "node bin/golden-suite.js",
    "test:lighthouse": "node bin/lighthouse-gate.js website/index.html --out .designos/lighthouse.json",
    "update:goldens": "node bin/golden-suite.js --update",
    "check:links": "node validators/check-links.js --fast",
    "review": "node bin/designos.js review",
    "visual": "node bin/designos.js visual",
    "report": "node bin/designos.js report",
    "elevate": "node bin/designos.js elevate",
    "starter": "node bin/designos.js starter",
    "brief": "node bin/designos.js brief",
    "eval": "node bin/designos.js eval",
    "case": "node bin/designos.js case",
    "demo:terminal": "node scripts/demo-session.js",
    "demo:transcript": "bash scripts/record-demo.sh",
    "demo:gif": "python3 scripts/render-demo-gif.py",
    "doctor": "node bin/designos.js doctor",
    "audit": "node bin/designos.js audit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
